---
import { profile } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="hero">
  <canvas class="hero-canvas" id="agent-graph" aria-hidden="true"></canvas>
  <div class="container content">
    <div class="text">
    <div class="status reveal">
      <span class="dot"></span> Open to lead AI architecture roles
    </div>
    <h1 class="reveal">
      {profile.name}
      <span class="grad-text role">{profile.role}</span>
    </h1>
    <p class="headline reveal">{profile.headline}</p>
    <p class="sub reveal">
      <span class="mono">Agent = LLM + Harness</span>
      <span class="sep">·</span> Multi-agent systems <span class="sep">·</span> RAG <span class="sep">·</span> AWS Bedrock & AgentCore
    </p>
    <div class="cta reveal">
      <a class="btn btn-primary" href={`${base}#projects`}>
        View my work
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="btn" href={`${base}${profile.resumePdf}`} download>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
        Download resume
      </a>
      <a class="btn" href={`${base}#contact`}>Get in touch</a>
    </div>
    <div class="meta reveal">
      <span>📍 {profile.location}</span>
      <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href={profile.github} target="_blank" rel="noopener">GitHub ↗</a>
    </div>
    </div>
    <figure class="portrait reveal">
      <div class="frame">
        <picture>
          <source media="(max-width: 900px)" srcset={`${base}${profile.photo}-avatar.webp`} type="image/webp" />
          <source media="(max-width: 900px)" srcset={`${base}${profile.photo}-avatar.jpg`} type="image/jpeg" />
          <source srcset={`${base}${profile.photo}.webp`} type="image/webp" />
          <img src={`${base}${profile.photo}.jpg`} alt={`Portrait of ${profile.name}`} width="440" height="587" fetchpriority="high" />
        </picture>
      </div>
      <figcaption class="badge-card">
        <span class="mono">4.5+ yrs</span>
        <span>Production GenAI</span>
      </figcaption>
    </figure>
  </div>
  <a class="scroll-hint" href={`${base}#impact`} aria-label="Scroll to impact">
    <span></span>
  </a>
</section>

<script>
  // Animated multi-agent graph: drifting nodes, nearby nodes link up, and "messages" travel along edges.
  const canvas = document.getElementById('agent-graph') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let w = 0, h = 0, dpr = 1;
  type N = { x: number; y: number; vx: number; vy: number; r: number; hub: boolean };
  let nodes: N[] = [];
  const pulses: { a: N; b: N; t: number }[] = [];

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = canvas.clientWidth;
    h = canvas.clientHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.round(Math.min(70, Math.max(24, (w * h) / 22000)));
    nodes = Array.from({ length: count }, (_, i) => ({
      x: Math.random() * w,
      y: Math.random() * h,
      vx: (Math.random() - 0.5) * 0.25,
      vy: (Math.random() - 0.5) * 0.25,
      hub: i % 9 === 0,
      r: i % 9 === 0 ? 3.2 : 1.6,
    }));
  }

  function colors() {
    const light = document.documentElement.dataset.theme === 'light';
    return light
      ? { line: '109, 40, 217', node: 'rgba(109,40,217,0.55)', hub: 'rgba(14,116,144,0.9)' }
      : { line: '139, 92, 246', node: 'rgba(200,210,255,0.55)', hub: 'rgba(34,211,238,0.95)' };
  }

  const LINK = 150;
  function frame() {
    const c = colors();
    ctx.clearRect(0, 0, w, h);
    for (const n of nodes) {
      n.x += n.vx; n.y += n.vy;
      if (n.x < 0 || n.x > w) n.vx *= -1;
      if (n.y < 0 || n.y > h) n.vy *= -1;
    }
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i], b = nodes[j];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < LINK) {
          ctx.strokeStyle = `rgba(${c.line}, ${(1 - d / LINK) * 0.28})`;
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          if (!reduce && (a.hub || b.hub) && Math.random() < 0.0016 && pulses.length < 14) pulses.push({ a, b, t: 0 });
        }
      }
    }
    for (const n of nodes) {
      ctx.fillStyle = n.hub ? c.hub : c.node;
      ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2); ctx.fill();
      if (n.hub) {
        ctx.strokeStyle = c.hub.replace(/[\d.]+\)$/, '0.25)');
        ctx.beginPath(); ctx.arc(n.x, n.y, n.r + 5, 0, Math.PI * 2); ctx.stroke();
      }
    }
    for (let i = pulses.length - 1; i >= 0; i--) {
      const p = pulses[i];
      p.t += 0.012;
      if (p.t >= 1) { pulses.splice(i, 1); continue; }
      const x = p.a.x + (p.b.x - p.a.x) * p.t, y = p.a.y + (p.b.y - p.a.y) * p.t;
      ctx.fillStyle = c.hub;
      ctx.shadowColor = c.hub; ctx.shadowBlur = 12;
      ctx.beginPath(); ctx.arc(x, y, 2.4, 0, Math.PI * 2); ctx.fill();
      ctx.shadowBlur = 0;
    }
    if (!reduce && !document.hidden) requestAnimationFrame(frame);
  }

  resize();
  frame();
  let t: number | undefined;
  window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(() => { resize(); if (reduce) frame(); }, 150); });
  document.addEventListener('visibilitychange', () => { if (!document.hidden && !reduce) requestAnimationFrame(frame); });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 120px 0 90px;
    overflow: hidden;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 45%, #000 30%, transparent 80%);
    opacity: 0.9;
  }
  .content { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 56px; align-items: center; }
  .portrait { position: relative; margin: 0; width: clamp(260px, 26vw, 360px); transition-delay: 0.2s; }
  .frame {
    position: relative;
    padding: 6px;
    border-radius: 28px;
    background: var(--grad);
    box-shadow: 0 30px 80px -30px rgba(139, 92, 246, 0.6), 0 0 0 1px var(--border);
    transform: rotate(2deg);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .portrait:hover .frame { transform: rotate(0deg) translateY(-4px); }
  .frame img { display: block; width: 100%; height: auto; aspect-ratio: 440 / 587; object-fit: cover; border-radius: 23px; }
  .badge-card {
    position: absolute;
    left: -28px;
    bottom: 36px;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg-2) 85%, transparent);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    font-size: 0.82rem;
    color: var(--muted);
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.5);
  }
  .badge-card .mono { font-size: 1rem; font-weight: 600; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6); animation: ping 2s infinite; }
  @keyframes ping { 70% { box-shadow: 0 0 0 10px rgba(34, 197, 94, 0); } 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); } }
  h1 { font-size: clamp(2.8rem, 8vw, 5.6rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.02; }
  .role { display: block; font-size: 0.62em; margin-top: 8px; padding-bottom: 0.08em; }
  .headline { font-size: clamp(1.1rem, 2.2vw, 1.4rem); color: var(--muted); max-width: 640px; margin: 28px 0 14px; }
  .sub { color: var(--faint); font-size: 0.95rem; }
  .mono { font-family: var(--mono); color: var(--accent); }
  .sep { margin: 0 6px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .meta { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 36px; color: var(--muted); font-size: 0.92rem; }
  .meta a:hover { color: var(--text); }
  .reveal:nth-child(2) { transition-delay: 0.08s; }
  .reveal:nth-child(3) { transition-delay: 0.16s; }
  .reveal:nth-child(4) { transition-delay: 0.24s; }
  .reveal:nth-child(5) { transition-delay: 0.32s; }
  .reveal:nth-child(6) { transition-delay: 0.4s; }
  .scroll-hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 38px;
    border: 2px solid var(--border);
    border-radius: 14px;
  }
  .scroll-hint span { position: absolute; left: 50%; top: 7px; width: 4px; height: 8px; margin-left: -2px; border-radius: 2px; background: var(--accent); animation: drop 1.8s infinite; }
  @keyframes drop { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(12px); } }
  @media (max-width: 900px) {
    .content { grid-template-columns: 1fr; gap: 0; }
    .portrait { order: -1; width: 132px; margin-bottom: 28px; }
    .frame { padding: 4px; border-radius: 50%; transform: none; }
    .frame img { aspect-ratio: 1; border-radius: 50%; }
    .badge-card { display: none; }
  }
  @media (max-width: 640px) { .scroll-hint { display: none; } .cta .btn { flex: 1 1 auto; justify-content: center; } }
</style>
