---
import { impact } from '../data/profile';
---

<section id="impact" class="impact">
  <div class="container">
    <div class="grid card reveal">
      {impact.map((m) => (
        <div class="stat">
          <div class="value grad-text">{m.value}</div>
          <div class="label">{m.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .impact { padding: 20px 0 40px; }
  .grid { display: grid; grid-template-columns: repeat(6, 1fr); padding: 8px; }
  .stat { padding: 26px 18px; text-align: center; border-right: 1px solid var(--border); }
  .stat:last-child { border-right: 0; }
  .value { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.03em; }
  .label { color: var(--muted); font-size: 0.84rem; margin-top: 6px; line-height: 1.4; }
  @media (max-width: 960px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .stat:nth-child(3) { border-right: 0; }
    .stat:nth-child(-n + 3) { border-bottom: 1px solid var(--border); }
  }
  @media (max-width: 540px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .stat { border-right: 1px solid var(--border) !important; border-bottom: 1px solid var(--border); }
    .stat:nth-child(2n) { border-right: 0 !important; }
    .stat:nth-last-child(-n + 2) { border-bottom: 0; }
  }
</style>
