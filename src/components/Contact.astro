---
import { profile } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="contact" class="section">
  <div class="container">
    <div class="card panel reveal">
      <div class="eyebrow">Contact</div>
      <h2 class="section-title">Let's build something <span class="grad-text">intelligent</span>.</h2>
      <p class="section-lead">
        Open to lead roles in AI architecture and to conversations about agentic AI platforms. The quickest way to reach me is email or LinkedIn.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          {profile.email}
        </a>
        <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a class="btn" href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone}</a>
        <a class="btn" href={`${base}${profile.resumePdf}`} download>Download resume</a>
      </div>
    </div>
  </div>
</section>

<style>
  .panel { padding: clamp(32px, 6vw, 72px); text-align: center; position: relative; overflow: hidden; }
  .panel::before {
    content: '';
    position: absolute;
    inset: -1px;
    background: radial-gradient(600px 260px at 50% 0%, rgba(139, 92, 246, 0.22), transparent 70%), radial-gradient(500px 220px at 50% 100%, rgba(34, 211, 238, 0.12), transparent 70%);
    pointer-events: none;
  }
  .panel > * { position: relative; }
  .eyebrow { justify-content: center; }
  .section-lead { margin: 0 auto 36px; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  @media (max-width: 540px) { .actions .btn { width: 100%; justify-content: center; word-break: break-all; } }
</style>
