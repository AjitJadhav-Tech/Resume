---
import type { Stage } from '../data/profile';

interface Props {
  stages: Stage[];
}
const { stages } = Astro.props;
---

<div class="arch" role="img" aria-label={`Architecture: ${stages.map((s) => `${s.label} (${s.nodes.join(', ')})`).join(', then ')}`}>
  {stages.map((s, i) => (
    <>
      <div class="stage reveal" style={`transition-delay:${i * 0.07}s`}>
        <div class="label">{s.label}</div>
        <div class="nodes">
          {s.nodes.map((n) => <div class="node">{n}</div>)}
        </div>
      </div>
      {i < stages.length - 1 && (
        <div class="link" aria-hidden="true"><span></span></div>
      )}
    </>
  ))}
</div>

<style>
  .arch { display: flex; align-items: stretch; gap: 0; overflow-x: auto; padding: 8px 2px 14px; }
  .stage { flex: 1 1 0; min-width: 132px; display: flex; flex-direction: column; gap: 10px; }
  .label { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); text-align: center; }
  .nodes { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 12px; border-radius: 14px; border: 1px dashed var(--border); background: var(--surface); }
  .node { padding: 10px 12px; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--border); font-size: 0.82rem; text-align: center; line-height: 1.35; }
  .link { flex: 0 0 32px; display: flex; align-items: center; padding-top: 22px; }
  .link span { position: relative; width: 100%; height: 2px; background: linear-gradient(90deg, var(--accent-1), var(--accent-2)); overflow: hidden; }
  .link span::after { content: ''; position: absolute; top: -2px; left: -8px; width: 8px; height: 6px; border-radius: 3px; background: #fff; box-shadow: 0 0 10px var(--accent-2); animation: flow 1.6s linear infinite; }
  @keyframes flow { to { left: 100%; } }

  @media (max-width: 760px) {
    .arch { flex-direction: column; overflow: visible; }
    .stage { min-width: 0; }
    .link { flex: 0 0 28px; justify-content: center; padding-top: 0; }
    .link span { width: 2px; height: 100%; background: linear-gradient(var(--accent-1), var(--accent-2)); }
    .link span::after { left: -2px; top: -8px; width: 6px; height: 8px; animation-name: flow-v; }
    @keyframes flow-v { to { top: 100%; } }
  }
</style>
