---
import { projects } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="projects" class="section">
  <div class="container">
    <div class="reveal">
      <div class="eyebrow">Delivered projects</div>
      <h2 class="section-title">Enterprise AI, <span class="grad-text">shipped to production</span>.</h2>
      <p class="section-lead">Selected platforms I designed and delivered. Client names are kept confidential.</p>
    </div>

    <div class="grid">
      {projects.map((p, i) => (
        <a href={`${base}projects/${p.slug}/`} class={`card hoverable project reveal ${i === 0 ? 'featured' : ''}`} style={`transition-delay:${(i % 2) * 0.08}s`}>
          <div class="top">
            <span class="client">{p.client}</span>
            <span class="period">{p.period}</span>
          </div>
          <h3>{p.name}</h3>
          <p class="subtitle">{p.subtitle}</p>
          <p class="summary">{p.summary}</p>
          <div class="results">
            {p.results.slice(0, i === 0 ? 5 : 3).map((r) => (
              <div><strong class="grad-text">{r.value}</strong><span>{r.label}</span></div>
            ))}
          </div>
          <div class="chips">
            {p.stack.slice(0, 6).map((s) => <span class="chip">{s}</span>)}
          </div>
          <span class="more">Read case study <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .project { padding: 30px; display: flex; flex-direction: column; position: relative; overflow: hidden; }
  .project::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(500px 200px at 100% 0%, rgba(139, 92, 246, 0.12), transparent 70%);
    pointer-events: none;
  }
  .featured, .project:last-child:nth-child(even) { grid-column: 1 / -1; }
  .top { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 0.8rem; margin-bottom: 18px; }
  .client { font-family: var(--mono); color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em; }
  .period { color: var(--faint); }
  h3 { font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 800; }
  .subtitle { color: var(--muted); margin: 6px 0 14px; font-weight: 500; }
  .summary { color: var(--muted); font-size: 0.96rem; max-width: 760px; }
  .results { display: flex; flex-wrap: wrap; gap: 28px; margin: 10px 0 22px; }
  .results div { display: flex; flex-direction: column; }
  .results strong { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; }
  .results span { color: var(--faint); font-size: 0.8rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: 22px; font-weight: 600; font-size: 0.92rem; color: var(--accent); }
  .more svg { width: 16px; height: 16px; transition: transform 0.25s; }
  .project:hover .more svg { transform: translateX(4px); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .project { padding: 24px; } .results { gap: 20px; } }
</style>
